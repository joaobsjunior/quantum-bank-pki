# quantum-bank-mobile-client-v1: post-quantum mobile client certificate profile.
# Subject public key: ML-DSA-65 (ML-DSA-87 accepted); issuer signature: ML-DSA-87.
[v3_client]
basicConstraints = critical, CA:FALSE
keyUsage = critical, digitalSignature
extendedKeyUsage = clientAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
